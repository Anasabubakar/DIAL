# ---- runtime ----
NODE_ENV=development
# ---- database (Supabase Postgres in production) ----
# Leave unset in local dev to use an embedded PGlite database under .data/
DATABASE_URL=
# ---- auth ----
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Dev only. Hard-fails when NODE_ENV=production.
DEV_AUTH=false
# ---- voice (BimpeAI) ----
VOICE_MODE=disabled          # disabled | demo
VOICE_TOOL_TOKEN=            # bearer configured on the BimpeAI customApi integration (>=32 chars)
VOICE_DEMO_USER_ID=          # the single isolated demo profile the voice token maps to
# ---- review/approval ----
REVIEW_TOKEN_SECRET=         # >=32 chars
# ---- drafting ----
DRAFTER=simulated            # simulated | gemini | openai
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# ---- email ----
EMAIL_PROVIDER=sandbox       # sandbox | resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=                  # verified DIAL sender, e.g. DIAL <apply@your-domain>
CONTROLLED_RECIPIENT=        # when set, ALL outbound mail is restricted to this address (smoke tests)
# ---- storage ----
STORAGE=local                # local | supabase
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=dial-files
# ---- additions ----
DOWNLOAD_TOKEN_SECRET=       # >=32 chars; signs 5-minute PDF download links (required in production)
WEB_ORIGIN=http://localhost:3000   # comma-separated allowed browser origins for the API
PORT=8080
DATA_DIR=.data               # local dev only: embedded database + files
EMBED_WORKER=false           # local dev only (PGlite is single-process). Rejected in production.
RUN_MIGRATIONS=false         # production: run `node apps/api/dist/migrate.js` as a deploy step instead
# ---- web app (server-side only) ----
API_URL=http://localhost:8080
SUPABASE_ANON_KEY=           # with SUPABASE_URL, enables real sign-in for the web app
PUBLIC_PHONE_NUMBER=         # shown on the landing page only when set. Never invent one.
