{
  "name": "@dial/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --noExternal @dial/contracts --noExternal @dial/db --noExternal @dial/core --noExternal @dial/providers --target node22",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@dial/contracts": "workspace:*",
    "@dial/core": "workspace:*",
    "@dial/db": "workspace:*",
    "@dial/providers": "workspace:*",
    "zod": "^4.6.5"
  }
}
