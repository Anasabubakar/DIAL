# Builds the API image. The worker image (Dockerfile.worker) differs only in its entrypoint.
FROM node:22-slim AS build
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @dial/api build

FROM node:22-slim
RUN corepack enable
ENV NODE_ENV=production MIGRATIONS_DIR=/app/packages/db/drizzle
WORKDIR /app
COPY --from=build /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml /app/.npmrc ./
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/api ./apps/api
RUN pnpm install --frozen-lockfile --prod --filter @dial/api...
USER node
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s CMD node -e "fetch('http://localhost:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/api/dist/main.js"]
