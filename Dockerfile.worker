FROM node:22-slim AS build
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @dial/worker build

FROM node:22-slim
RUN corepack enable
ENV NODE_ENV=production MIGRATIONS_DIR=/app/packages/db/drizzle
WORKDIR /app
COPY --from=build /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml /app/.npmrc ./
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/worker ./apps/worker
RUN pnpm install --frozen-lockfile --prod --filter @dial/worker...
USER node
EXPOSE 8081
HEALTHCHECK --interval=15s --timeout=3s CMD node -e "fetch('http://localhost:8081').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# SIGTERM lets the loop finish its current job before exiting (graceful shutdown).
STOPSIGNAL SIGTERM
CMD ["node", "apps/worker/dist/main.js"]
